# Credenciales locales — NUNCA versionar
github_token.txt
*.token
.env
*.pem
*.key

# Descargas de repositorios de terceros y corpus construidos (se rehacen con `fetch` y `build`)
data/raw/
data/cache/

# Recursos de terceros con derechos o no redistribuibles (uso local; se documentan por huella en provenance.json)
data/local/Diorisis.zip
data/local/NA28*
*.zip

# Entornos y cachés de Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Matrices grandes de ejecuciones completas (se rehacen con `run --stage ledger`)
